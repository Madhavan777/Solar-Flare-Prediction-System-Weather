root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,pyi}]
max_line_length = 100

[*.{html,css,js,json,yml,yaml,toml,cff}]
indent_size = 2

[*.md]
# Trailing whitespace is significant for Markdown line breaks.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bat,ps1}]
end_of_line = crlf
